# Port d'écoute du serveur MAIA Beacon
BEACON_HOST=0.0.0.0
BEACON_PORT=11343

# Chemins vers les binaires et modèles locaux sur la machine GPU
# Vous pouvez utiliser des chemins relatifs ou absolus
LLAMA_SERVER_EXE=
MODELS_DIR=

# Adresse et port du processus llama-server local géré par Beacon
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080

# URL de l'instance Ollama locale éventuelle (optionnel)
OLLAMA_HOST=http://127.0.0.1:11434

# Mise en veille automatique du modèle après inactivité (en secondes, 300 = 5 minutes, 0 = désactivé)
IDLE_TIMEOUT_SECONDS=300

# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
